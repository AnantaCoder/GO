# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the ones you don't use)
vendor/

# Go workspace file
go.work
go.work.sum

# Go module files (only ignore if you don’t want to track them)
